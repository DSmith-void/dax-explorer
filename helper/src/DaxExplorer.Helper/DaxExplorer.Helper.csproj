<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-only: finds Power BI Desktop through Windows process and network APIs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- A Windows program without a console window: it lives in the tray (Tray.cs). -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/dax-explorer.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>DaxExplorer.Helper</RootNamespace>
    <!-- The packaged program is DaxExplorer.exe (see scripts/package.mjs). -->
    <AssemblyName>DaxExplorer</AssemblyName>
    <Product>DAX Execution Explorer</Product>
    <!-- Packaging: no IIS web.config and no static-web-assets manifest (the helper serves the app itself). -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only settings are not shipped. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft's official client for Analysis Services / Power BI engines (ADOMD.NET). -->
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient" Version="19.118.3" />
    <!-- Traces (Capture from Desktop): the same Microsoft family and version as the client above. -->
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.118.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaxExplorer.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon on Power BI's External Tools ribbon: public/favicon.svg drawn at 64 px. -->
    <EmbeddedResource Include="Assets/external-tool-icon.png" LogicalName="DaxExplorer.Helper.Assets.external-tool-icon.png" />
    <!-- The tray icon and the program icon (the same picture). -->
    <EmbeddedResource Include="Assets/dax-explorer.ico" LogicalName="DaxExplorer.Helper.Assets.dax-explorer.ico" />
  </ItemGroup>

</Project>
